#!/bin/bash
source /repos/UmbraNet-Util/umbraScriptUtil.config.bash
source /repos/UmbraNet-Util/docker/docker_env_config.umbra.bash
# Remove all older than 30 days
find ${SERVICE_BACKUP_ROOT} -type f -mtime +30 | xargs rm
# Generate fresh backups
${SERVICE_REPO_ROOT}/run_service_backups.bash > ${SERVICE_BACKUP_ROOT}/${DATE_STAMP}.log 2>&1
# Set the proper permissions for reading
chmod 766 /home/umbra/Umbra-Blade_Backups/logs/${DATE_STAMP}.log
